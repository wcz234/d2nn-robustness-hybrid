# Build artifacts and local state
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Datasets are downloaded by torchvision at first run
data/
simulator/data/

# Training checkpoints and exported plates are distributed via releases, not git
artifacts/
checkpoints/
exports/
*.pth

# Per-sample prediction streams. These are ~240 MB per robustness evaluation
# (~7.4 GB for the full study) and are regenerated by the evaluation commands.
predictions.jsonl

# 600 dpi TIFF figures are submission assets; the release ships vector PDF/SVG
*.tiff

# Local transfer staging and scratch
tmp/
dist/
*.tar.gz
*.log

# Editor and OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db

# A local .doc copy of an external review letter, if present
*.doc
